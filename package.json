{
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:check": "node --env-file=.env --conditions=react-server --experimental-strip-types scripts/check-db.mjs",
    "db:migrate": "node --env-file=.env --conditions=react-server --import tsx scripts/migrate.ts",
    "worker": "node --env-file=.env --conditions=react-server --import tsx scripts/worker.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --env-file=.env --conditions=react-server --import tsx tests/integration.ts",
    "dev:all": "node scripts/dev.mjs",
    "format": "prettier --write \"components/canvas/**/*.{ts,tsx}\" \"lib/*.ts\" \"scripts/*.{ts,mjs}\" \"tests/*.ts\" \"app/**/*.{ts,tsx}\" app/globals.css proxy.ts",
    "test:registration": "node --env-file=.env --conditions=react-server --import tsx tests/registration-ui.ts",
    "test:agent": "node --env-file=.env --conditions=react-server --import tsx tests/agent-api.ts",
    "test:agent:ui": "node --env-file=.env --conditions=react-server --import tsx tests/agent-ui.ts",
    "test:markdown": "tsx tests/markdown.tsx",
    "test:image-bounds": "node --conditions=react-server --import tsx tests/image-bounds.ts",
    "test:skills": "node --env-file=.env --conditions=react-server --import tsx tests/skills-api.ts",
    "test:skills:ui": "node --env-file=.env --conditions=react-server --import tsx tests/skills-ui.ts",
    "test:skills:parser": "node --conditions=react-server --import tsx tests/skills-parser.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@earendil-works/pi-agent-core": "^1.6.0",
    "@earendil-works/pi-ai": "^1.6.0",
    "@lobehub/icons": "^6.20.0",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "@xyflow/react": "^13.0.2",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "next": "latest",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.65.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.3.1",
    "postcss": "^8",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
