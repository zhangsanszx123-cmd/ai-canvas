# Server-side PostgreSQL connection (never use a NEXT_PUBLIC_ prefix)
DATABASE_URL=postgresql://username:password@localhost:5432/ai-canvas

# Optional database CA certificate file path; connection code must explicitly load it
DB_CA_CERT=
# Optional verified certificate identity when connecting through an internal alias
DB_TLS_SERVERNAME=

# Server-side image generation (origin only, without /v1)
TOAPIS_BASE_URL=https://toapis.cn
TOAPIS_API_KEY=
TOAPIS_GPT_IMAGE_MODEL=gpt-image-2
# Confirmed Nano Banana model; shares TOAPIS_API_KEY
TOAPIS_NANO_BANANA_MODEL=gemini-nano-banana-2.1
# Optional extra trusted result-image hostnames, comma-separated; no scheme or path
TOAPIS_IMAGE_HOSTS=

# Application origin (also passed to Better Auth as baseURL)
APP_URL=http://localhost:3000
# Server-side Better Auth secret: generate at least 32 high-entropy characters locally
BETTER_AUTH_SECRET=

# Existing S3-compatible storage
STORAGE_PROVIDER=s3
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Optional: only for a provider requiring path-style addressing or temporary credentials
S3_FORCE_PATH_STYLE=false
S3_SESSION_TOKEN=

# Optional password reset email; registration does not require email verification
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
